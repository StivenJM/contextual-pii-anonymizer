# syntax=docker/dockerfile:1
FROM python:3.14-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.12.9 /uv /bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

FROM python:3.14-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
RUN groupadd --gid 10001 research \
    && useradd --uid 10001 --gid 10001 --no-create-home research \
    && mkdir -p /data && chown research:research /data && chmod 700 /data
WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY app/research ./app/research
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.research.application:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--no-proxy-headers", "--limit-concurrency", "64", "--timeout-keep-alive", "5"]
