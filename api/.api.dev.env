# Copy this file to .api.env.
BENTOML_URL=http://inference:3000
BENTOML_TIMEOUT_SECONDS=120

# Research
RESEARCH_ENABLED="true"
# Investigator/operator only: export, investigator-mediated deletion and purge.
RESEARCH_API_KEY=una_clave_privada_de_al_menos_32_caracteres
# Participant-facing study code. It must be distinct from RESEARCH_API_KEY.
RESEARCH_ENROLLMENT_KEY=un_codigo_de_participacion_de_al_menos_32_caracteres
RESEARCH_STORAGE_PATH=/data/research/capture.sqlite3
RESEARCH_PROTOCOL_VERSION=research-v1
RESEARCH_RETENTION_DAYS=7