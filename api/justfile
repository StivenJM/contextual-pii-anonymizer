set shell := ["powershell.exe", "-NoLogo", "-Command"]

lint:
    uv run ruff check .

lint-fix:
    uv run ruff check . --fix

format:
    uv run ruff format --check .

format-fix:
    uv run ruff format .

test:
    uv run pytest

test-unit:
    uv run pytest tests/unit

test-integration:
    $env:RUN_DATABASE_INTEGRATION="1"; uv run pytest tests/integration -m integration
